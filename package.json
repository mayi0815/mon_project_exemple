{
  "name": "mtech-paris-events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "start": "HOST=127.0.0.1 node dist/server/entry.mjs",
    "test": "node --test tests/store.test.mjs tests/newsletter.test.mjs tests/human-verification.test.mjs",
    "newsletter:purge": "node scripts/newsletter-purge.mjs",
    "test:integration": "npm run build && node --test tests/http.test.mjs"
  },
  "dependencies": { "astro": "7.4.7", "@astrojs/node": "11.1.11" },
  "devDependencies": { "@astrojs/check": "0.9.12", "typescript": "~5.9.3", "@types/node": "^25.0.0" }
}
